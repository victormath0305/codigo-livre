{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "api",
      "framework": "fastify",
      "entrypoint": "src/server.ts",
      "installCommand": "pnpm install --no-frozen-lockfile",
      "buildCommand": "pnpm --filter @freecodecamp/shared build && pnpm build",
      "bindings": [
        {
          "type": "service",
          "service": "client",
          "format": "url",
          "env": "CLIENT_URL"
        }
      ]
    },
    "client": {
      "root": "client",
      "framework": "gatsby",
      "installCommand": "pnpm install --no-frozen-lockfile",
      "buildCommand": "cd .. && pnpm run build:client",
      "outputDirectory": "public",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
